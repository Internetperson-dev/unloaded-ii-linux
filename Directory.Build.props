<Project>
  <PropertyGroup>
    <!-- Pinned to net9.0 on purpose: the bundled Reloaded loader's
         runtimeconfig targets net9.0 with rollForward=Minor, so a mod built
         for net10+ would fail to load in the game's hosted runtime. -->
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <!-- Release publishes must always carry optimized IL. -->
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
